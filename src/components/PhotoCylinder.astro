---
interface Props {
  images: { src: string; alt: string }[]
}
const { images } = Astro.props
const n = images.length
---

<div class="cyl" data-cylinder style={`--n:${n}`} tabindex="0" aria-roledescription="carousel" aria-label="Photo gallery">
  <div class="cyl-stage">
    <div class="cyl-ring">
      {images.map((img, i) => (
        <button type="button" class="cyl-card" style={`--i:${i}`} aria-label={`Photo ${i + 1}`}>
          <img src={img.src} alt={img.alt} draggable="false" />
        </button>
      ))}
    </div>
  </div>
  <div class="cyl-bar">
    <button type="button" data-prev aria-label="Previous photo">←</button>
    <div class="cyl-ring-ui" data-dial role="slider" aria-label="Photo position" aria-valuemin="1" aria-valuemax={n} aria-valuenow="1">
      <svg viewBox="0 0 76 76" aria-hidden="true">
        <circle class="dial-track" cx="38" cy="38" r="34" />
        <circle class="dial-thumb" data-thumb cx="38" cy="38" r="34" />
      </svg>
      <span data-counter>01 / {String(n).padStart(2, '0')}</span>
    </div>
    <button type="button" data-next aria-label="Next photo">→</button>
  </div>
  <div class="cyl-lb" data-lb hidden role="dialog" aria-modal="true" aria-label="Enlarged photo">
    <button type="button" class="cyl-lb-btn cyl-lb-close" data-lb-close aria-label="Close">×</button>
    <button type="button" class="cyl-lb-btn cyl-lb-prev" data-lb-prev aria-label="Previous photo">←</button>
    <img data-lb-img alt="" />
    <button type="button" class="cyl-lb-btn cyl-lb-next" data-lb-next aria-label="Next photo">→</button>
  </div>
</div>

<style>
  .cyl {
    --w: 200px; /* fallback — JS sizes it to the viewport */
    --h: calc(var(--w) * 1.5);
    outline: none;
    user-select: none;
  }
  .cyl:focus-visible .cyl-stage {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
  .cyl-stage {
    height: calc(var(--h) + 60px);
    perspective: 2200px;
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
  }
  .cyl-stage:active {
    cursor: grabbing;
  }
  .cyl-ring {
    position: relative;
    width: var(--w);
    height: var(--h);
    margin: 40px auto 0;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--r) * -1)) rotateY(var(--a, 0deg));
  }
  .cyl-card {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: var(--color-parchment);
    backface-visibility: hidden;
    transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(var(--r));
    cursor: inherit;
  }
  .cyl-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .cyl-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 4px;
    font-size: 12px;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .cyl-bar button {
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    font-size: 17px;
    color: var(--color-accent);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    background: var(--color-canvas);
  }
  .cyl-bar button:hover {
    background: var(--color-parchment);
  }
  .cyl-ring-ui {
    position: relative;
    width: 76px;
    height: 76px;
    display: grid;
    place-items: center;
    cursor: pointer;
    touch-action: none;
  }
  .cyl-ring-ui svg {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }
  .cyl-ring-ui circle {
    fill: none;
    stroke-linecap: round;
  }
  .dial-track {
    stroke: var(--color-hairline);
    stroke-width: 2;
  }
  .dial-thumb {
    stroke: var(--color-accent);
    stroke-width: 4;
  }
  .cyl-lb {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: rgb(255 255 255 / 0.96);
  }
  .cyl-lb[hidden] {
    display: none;
  }
  .cyl-lb img {
    max-width: min(92vw, 1200px);
    max-height: 90vh;
    object-fit: contain;
  }
  .cyl-lb-btn {
    position: absolute;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    font-size: 20px;
    color: var(--color-accent);
    background: var(--color-canvas);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .cyl-lb-btn:hover {
    background: var(--color-parchment);
  }
  .cyl-lb-close {
    top: 16px;
    right: 16px;
  }
  .cyl-lb-prev {
    left: 16px;
    top: 50%;
    translate: 0 -50%;
  }
  .cyl-lb-next {
    right: 16px;
    top: 50%;
    translate: 0 -50%;
  }
</style>

<script>
  // ponytail: per-frame lerp toward a snapped target; no inertia physics, upgrade only if flick feel matters
  let raf = 0

  function init() {
    cancelAnimationFrame(raf)
    const root = document.querySelector<HTMLElement>('[data-cylinder]')
    if (!root) return
    const stage = root.querySelector<HTMLElement>('.cyl-stage')!
    const ring = root.querySelector<HTMLElement>('.cyl-ring')!
    const cards = [...root.querySelectorAll<HTMLElement>('.cyl-card')]
    const n = cards.length
    const counter = root.querySelector<HTMLElement>('[data-counter]')!
    const dial = root.querySelector<HTMLElement>('[data-dial]')!
    const thumb = root.querySelector<SVGCircleElement>('[data-thumb]')!
    const circ = 2 * Math.PI * 34
    const arc = Math.max(circ / n - 3, 4) // thumb = one photo's slice of the ring
    thumb.style.strokeDasharray = `${arc} ${circ - arc}`
    const step = 360 / n
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches

    let angle = 0
    let target = 0
    let dragging = false
    let moved = 0
    let idle = 0

    const layout = () => {
      // fit the ring to what is left of the viewport below the page heading (dial bar ≈ 80px + 24px breathing room)
      const top = root.getBoundingClientRect().top + scrollY
      const h = innerHeight - top - 80 - 24 - 60
      const w = Math.max(110, Math.min(h / 1.5, innerWidth * (innerWidth < 640 ? 0.5 : 0.3)))
      root.style.setProperty('--w', `${w}px`)
      root.style.setProperty('--r', `${(w * 1.18) / 2 / Math.tan(Math.PI / n)}px`)
    }
    const snap = () => {
      target = Math.round(target / step) * step
    }
    const nudge = (d: number) => {
      target = Math.round(target / step) * step + d * step
    }

    stage.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault()
        target -= (Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY) * 0.12
        clearTimeout(idle)
        idle = window.setTimeout(snap, 140)
      },
      { passive: false },
    )

    let startX = 0
    let startT = 0
    let lastX = 0
    let lastTime = 0
    let vel = 0
    stage.addEventListener('pointerdown', (e) => {
      dragging = true
      moved = 0
      startX = lastX = e.clientX
      startT = target
      lastTime = e.timeStamp
      vel = 0
      stage.setPointerCapture(e.pointerId)
    })
    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return
      const dx = e.clientX - startX
      moved = Math.max(moved, Math.abs(dx))
      target = startT + dx * 0.3
      const dt = e.timeStamp - lastTime
      if (dt > 0) vel = ((e.clientX - lastX) * 0.3) / dt
      lastX = e.clientX
      lastTime = e.timeStamp
    })
    const end = () => {
      if (!dragging) return
      dragging = false
      target += vel * 180
      snap()
    }
    stage.addEventListener('pointerup', end)
    stage.addEventListener('pointercancel', end)

    const lb = root.querySelector<HTMLElement>('[data-lb]')!
    const lbImg = root.querySelector<HTMLImageElement>('[data-lb-img]')!
    let lbIndex = 0
    const goto = (i: number) => {
      const k = Math.round((-target / step - i) / n) // stay on the nearest lap
      target = -(i + k * n) * step
    }
    const showLb = (i: number) => {
      lbIndex = ((i % n) + n) % n
      const src = cards[lbIndex].querySelector('img')!
      lbImg.src = src.currentSrc || src.src
      lbImg.alt = src.alt
      goto(lbIndex) // keep the cylinder in sync for when the lightbox closes
    }
    const openLb = (i: number) => {
      showLb(i)
      lb.hidden = false
      document.body.style.overflow = 'hidden'
      lb.querySelector<HTMLElement>('[data-lb-close]')!.focus()
    }
    const closeLb = () => {
      lb.hidden = true
      document.body.style.overflow = ''
      root.focus()
    }
    lb.querySelector('[data-lb-close]')!.addEventListener('click', closeLb)
    lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => showLb(lbIndex - 1))
    lb.querySelector('[data-lb-next]')!.addEventListener('click', () => showLb(lbIndex + 1))
    lb.addEventListener('click', (e) => {
      if (e.target === lb) closeLb()
    })
    lbImg.addEventListener('click', closeLb)
    document.addEventListener('keydown', (e) => {
      if (lb.hidden || !root.isConnected) return
      if (e.key === 'Escape') closeLb()
      if (e.key === 'ArrowLeft') showLb(lbIndex - 1)
      if (e.key === 'ArrowRight') showLb(lbIndex + 1)
    })

    cards.forEach((c, i) =>
      c.addEventListener('click', () => {
        if (moved > 6) return
        const cur = ((Math.round(-target / step) % n) + n) % n
        if (i === cur) return openLb(i) // front photo → enlarge
        let d = (((i - cur) % n) + n) % n
        if (d > n / 2) d -= n
        target -= d * step
      }),
    )

    const seek = (e: PointerEvent) => {
      const r = dial.getBoundingClientRect()
      const a = Math.atan2(e.clientX - (r.left + r.width / 2), -(e.clientY - (r.top + r.height / 2))) // 0 at top, clockwise
      const i = ((a / (2 * Math.PI)) % 1 + 1) % 1 * n
      const k = Math.round((-target / step - i) / n) // stay on the nearest lap
      target = -(i + k * n) * step
    }
    dial.addEventListener('pointerdown', (e) => {
      dial.setPointerCapture(e.pointerId)
      seek(e)
    })
    dial.addEventListener('pointermove', (e) => {
      if (dial.hasPointerCapture(e.pointerId)) seek(e)
    })
    dial.addEventListener('pointerup', snap)

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        nudge(-1)
        e.preventDefault()
      }
      if (e.key === 'ArrowLeft') {
        nudge(1)
        e.preventDefault()
      }
    })
    root.querySelector('[data-next]')!.addEventListener('click', () => nudge(-1))
    root.querySelector('[data-prev]')!.addEventListener('click', () => nudge(1))
    addEventListener('resize', layout)

    layout()
    const tick = () => {
      angle += (target - angle) * (still ? 1 : 0.11)
      if (Math.abs(target - angle) < 0.01) angle = target
      ring.style.setProperty('--a', `${angle}deg`)
      cards.forEach((c, i) => {
        const d = ((((i * step + angle) % 360) + 540) % 360) - 180 // signed angular distance from the front card
        c.style.opacity = String(1 - Math.min(1, Math.abs(d) / 100) * 0.75)
      })
      const idx = ((Math.round(-angle / step) % n) + n) % n
      const pos = ((-angle / step) % n + n) % n
      thumb.style.strokeDashoffset = String(-(pos / n) * circ)
      dial.setAttribute('aria-valuenow', String(idx + 1))
      counter.textContent = `${String(idx + 1).padStart(2, '0')} / ${String(n).padStart(2, '0')}`
      raf = requestAnimationFrame(tick)
    }
    tick()
  }

  document.addEventListener('astro:page-load', init)
  document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf))
</script>
