---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'

interface Props {
  title: string
  dark?: boolean
}

const { title, dark = false } = Astro.props
const path = Astro.url.pathname

const navItems = [
  { number: 1, label: 'Home', href: '/' },
  { number: 2, label: 'Projects', href: '/projects' },
  { number: 3, label: 'About', href: '/about' },
]

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-canvas text-ink" data-theme={dark ? 'dark' : undefined}>
    <canvas class="plus-glow" aria-hidden="true"></canvas>
    <header class="sticky top-0 z-10 border-b border-hairline/60 bg-canvas/80 backdrop-blur-md">
      <nav class="mx-auto flex max-w-5xl items-center gap-6 px-6 py-4">
        <a href="/" class="text-[14px] font-semibold tracking-[-0.224px]">KOKORE</a>
        <ul class="flex items-center gap-1 text-[12px] text-ink-muted">
          {navItems.map((item, i) => (
            <li class="flex items-center gap-1">
              {i > 0 && <span class="mx-1 text-hairline">/</span>}
              <a
                href={item.href}
                class:list={[
                  'group flex items-center gap-1.5 rounded-full px-2 py-1 transition-colors',
                  isActive(item.href) ? 'text-ink' : 'hover:text-ink',
                ]}
              >
                <span
                  class:list={[
                    'flex h-5 w-5 items-center justify-center rounded-full text-[11px] transition-colors',
                    isActive(item.href) ? 'bg-accent text-white' : 'bg-parchment text-ink-muted group-hover:bg-hairline/60',
                  ]}
                >
                  {item.number}
                </span>
                <span
                  class:list={[
                    'overflow-hidden whitespace-nowrap transition-all duration-200',
                    isActive(item.href) ? 'max-w-[80px] opacity-100' : 'max-w-0 opacity-0 group-hover:max-w-[80px] group-hover:opacity-100',
                  ]}
                >
                  {item.label}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-hairline/60 bg-parchment px-6 py-16 text-center">
      <p class="text-[14px] text-ink-muted">
        <a href="mailto:kokore0214@gmail.com" class="text-ink hover:text-accent transition-colors">kokore0214@gmail.com</a>
      </p>
      <p class="mt-2 text-[12px] text-ink-muted">
        <a href="https://www.instagram.com/jutopia_214/?hl=ko" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">Instagram</a>
        ·
        <a href="https://www.linkedin.com/in/juwon-kim-1q2w3e4r/" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">LinkedIn</a>
      </p>
      <p class="mt-8 text-[12px] text-ink-muted">&copy; {new Date().getFullYear()} Portfolio</p>
    </footer>
    <script>
      // "+" marks that are born around the cursor as it moves: each one fades in at a random spot
      // nearby, turns slowly, and fades out — nothing is laid out in advance, so the same spot can
      // hold a plus one moment and nothing the next. Grey by default, blue while the mouse is pressed.
      // Pointer-only (hover devices) — touch screens keep the plain background.
      if (matchMedia('(hover: hover)').matches) {
        type Plus = { x: number; y: number; born: number; life: number; rot: number; spin: number; arm: number; vx: number; vy: number }
        const SPAWN_EVERY = 34 // px of cursor travel per new plus
        const SPREAD = [14, 100] // min/max distance from the cursor a plus can appear at
        const LIFE = [1400, 2600] // ms
        const MAX = 45
        const pluses: Plus[] = []
        let lx = 0, ly = 0, travelled = 0, seen = false
        let blue = 0 // grey→blue mix 0..1
        let down = false
        let raf = 0
        let canvas: HTMLCanvasElement | null = null
        let ctx: CanvasRenderingContext2D | null = null
        let dpr = 1

        const rand = (a: number, b: number) => a + Math.random() * (b - a)
        const rgb = (css: string): [number, number, number] => {
          const hex = css.trim().match(/^#([0-9a-f]{6})$/i)?.[1] // theme tokens are 6-digit hex
          if (!hex) return [128, 128, 128]
          const n = parseInt(hex, 16)
          return [(n >> 16) & 255, (n >> 8) & 255, n & 255]
        }
        const ensure = () => {
          const el = document.querySelector<HTMLCanvasElement>('.plus-glow')
          if (!el) return false
          if (el !== canvas || el.width !== Math.round(innerWidth * dpr)) {
            canvas = el
            dpr = Math.min(devicePixelRatio || 1, 2)
            el.width = Math.round(innerWidth * dpr)
            el.height = Math.round(innerHeight * dpr)
            ctx = el.getContext('2d')
          }
          return true
        }

        const spawn = (cx: number, cy: number) => {
          const ang = rand(0, Math.PI * 2)
          const dist = rand(SPREAD[0], SPREAD[1])
          pluses.push({
            x: cx + Math.cos(ang) * dist,
            y: cy + Math.sin(ang) * dist,
            born: performance.now(),
            life: rand(LIFE[0], LIFE[1]),
            rot: rand(0, Math.PI),
            spin: rand(0.25, 0.7) * (Math.random() < 0.5 ? -1 : 1), // rad/s — slow
            arm: rand(3.5, 7),
            vx: rand(-6, 6), // gentle drift, px/s
            vy: rand(-10, -2), // tends to float upward
          })
          if (pluses.length > MAX) pluses.shift()
        }

        const loop = (now: number) => {
          blue += ((down ? 1 : 0) - blue) * (down ? 0.3 : 0.08) // snaps blue on press, eases back on release
          if (ensure() && ctx) {
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
            ctx.clearRect(0, 0, innerWidth, innerHeight)
            const css = getComputedStyle(document.body)
            const grey = rgb(css.getPropertyValue('--color-ink-muted'))
            const accent = rgb(css.getPropertyValue('--color-accent'))
            const col = grey.map((g, k) => Math.round(g + (accent[k] - g) * blue))
            ctx.lineWidth = 1.4
            ctx.lineCap = 'round'
            for (let i = pluses.length - 1; i >= 0; i--) {
              const p = pluses[i]
              const t = (now - p.born) / p.life
              if (t >= 1) {
                pluses.splice(i, 1)
                continue
              }
              const age = (now - p.born) / 1000
              const alpha = Math.sin(Math.PI * t) * 0.85 // fade in, then out
              ctx.save()
              ctx.translate(p.x + p.vx * age, p.y + p.vy * age)
              ctx.rotate(p.rot + p.spin * age)
              ctx.strokeStyle = `rgba(${col[0]}, ${col[1]}, ${col[2]}, ${alpha.toFixed(3)})`
              ctx.beginPath()
              ctx.moveTo(-p.arm, 0)
              ctx.lineTo(p.arm, 0)
              ctx.moveTo(0, -p.arm)
              ctx.lineTo(0, p.arm)
              ctx.stroke()
              ctx.restore()
            }
          }
          raf = pluses.length || Math.abs((down ? 1 : 0) - blue) > 0.01 ? requestAnimationFrame(loop) : 0
        }
        const wake = () => {
          if (!raf) raf = requestAnimationFrame(loop)
        }

        addEventListener('pointermove', (e) => {
          if (!seen) {
            lx = e.clientX
            ly = e.clientY
            seen = true
          }
          travelled += Math.hypot(e.clientX - lx, e.clientY - ly)
          lx = e.clientX
          ly = e.clientY
          let n = 0
          while (travelled >= SPAWN_EVERY && n < 3) {
            spawn(e.clientX, e.clientY)
            travelled -= SPAWN_EVERY
            n++
          }
          if (n === 3) travelled = 0 // fast flick: don't bank a burst for later
          wake()
        })
        addEventListener('pointerdown', () => {
          down = true
          wake()
        })
        const release = () => {
          down = false
          wake()
        }
        addEventListener('pointerup', release)
        addEventListener('pointercancel', release)
        document.documentElement.addEventListener('mouseleave', () => {
          down = false
          seen = false
          wake()
        })
        addEventListener('resize', () => {
          canvas = null // forces a resize on the next frame
          wake()
        })
      }
    </script>
  </body>
</html>
