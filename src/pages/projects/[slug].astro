---
import Layout from '../../layouts/Layout.astro'
import { projects, categoryLabels } from '../../data/projects'

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }))
}

const { project } = Astro.props
---

<Layout title={`${project.title} — Portfolio`}>
  <section class="mx-auto max-w-5xl px-6 py-16">
    <p class="text-[12px] text-ink-muted">{categoryLabels[project.category]}</p>
    <h1 class="mt-2 text-[40px] font-semibold leading-[1.1] tracking-[0]">{project.title}</h1>
    <p class="mt-3 text-[14px] text-ink-muted">{project.tags.join(', ')}</p>
    <p class="mt-8 max-w-xl text-[17px] leading-[1.47] tracking-[-0.374px] text-ink-muted">
      {project.description}
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-16">
    {project.image ? (
      <img src={project.image} alt={project.title} class="w-full" />
    ) : (
      <div class="aspect-[16/9] w-full bg-parchment"></div>
    )}
  </section>

  {project.caseStudy && (
    <section class="mx-auto max-w-3xl px-6 pb-24">
      <div class="flex flex-col gap-16">
        {project.caseStudy.map((block) => {
          if (block.type === 'heading') {
            return (
              <div>
                <h2 class="text-[28px] font-semibold leading-[1.14] tracking-[0]">{block.en}</h2>
                {block.ja && <p class="mt-2 text-[14px] leading-[1.7] text-ink-muted">{block.ja}</p>}
              </div>
            )
          }
          if (block.type === 'spec') {
            return <p class="text-[12px] tracking-[-0.12px] text-ink-muted">{block.en}</p>
          }
          if (block.type === 'image') {
            return <img src={block.src} alt={block.alt} class="w-full" loading="lazy" />
          }
          return (
            <div class="grid gap-8 sm:grid-cols-2">
              <p class="whitespace-pre-line text-[17px] leading-[1.47] tracking-[-0.374px]">{block.en}</p>
              {block.ja && <p class="whitespace-pre-line text-[14px] leading-[1.7] text-ink-muted">{block.ja}</p>}
            </div>
          )
        })}
      </div>
    </section>
  )}

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <a
      href="/projects"
      class="inline-flex items-center gap-1 rounded-full bg-canvas px-[22px] py-[11px] text-[17px] text-accent ring-1 ring-hairline hover:bg-parchment"
    >
      ← All projects
    </a>
  </section>
</Layout>
