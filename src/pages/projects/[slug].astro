---
import Layout from '../../layouts/Layout.astro'
import { projects, categoryLabels } from '../../data/projects'

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }))
}

const { project } = Astro.props
---

<Layout title={`${project.title} — Portfolio`}>
  <section class="mx-auto max-w-5xl px-6 py-16">
    <p class="text-[12px] text-ink-muted">{categoryLabels[project.category]}</p>
    <h1 class="mt-2 text-[40px] font-semibold leading-[1.1] tracking-[0]">{project.title}</h1>
    <p class="mt-3 text-[14px] text-ink-muted">{project.tags.join(', ')}</p>
    <p class="mt-8 max-w-xl text-[17px] leading-[1.47] tracking-[-0.374px] text-ink-muted">
      {project.description}
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-16">
    <div class="aspect-[16/9] w-full rounded-[18px] bg-parchment"></div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <a
      href="/projects"
      class="inline-flex items-center gap-1 rounded-full bg-canvas px-[22px] py-[11px] text-[17px] text-accent ring-1 ring-hairline hover:bg-parchment"
    >
      ← All projects
    </a>
  </section>
</Layout>
